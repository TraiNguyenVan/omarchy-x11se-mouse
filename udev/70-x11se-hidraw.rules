# Grant the active desktop session access to X11SE settings reports.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa60", ENV{ID_USB_INTERFACE_NUM}=="02", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="2125", ENV{ID_USB_INTERFACE_NUM}=="02", MODE="0660", TAG+="uaccess"
