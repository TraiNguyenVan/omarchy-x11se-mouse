#!/usr/bin/env python3
"""Command-line interface for Attack Shark X11SE status and tuning."""
from __future__ import annotations

import argparse
import json
import os
import contextlib
import secrets
import stat
import sys
import time
import traceback
from pathlib import Path

PLUGIN_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_DIR))

import x11se_mouse as mouse
from model_catalog import X11SE, X11SE_WIRED


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="x11se-mouse", description="Read and tune an Attack Shark X11SE mouse")
    parser.add_argument("--device", help="use a specific hidraw device (default: discover interface 02)")
    parser.add_argument("--debug", action="store_true", help="print Python tracebacks for CLI and watcher errors")
    commands = parser.add_subparsers(dest="command", required=True)

    def add_debug_option(command_parser: argparse.ArgumentParser) -> None:
        command_parser.add_argument("--debug", action="store_true", default=argparse.SUPPRESS,
                                    help="print Python tracebacks for errors")

    commands.add_parser("capabilities", help="print X11SE model capabilities as JSON")
    commands.add_parser("devices", help="detect receiver and wired interfaces without sending HID commands")
    commands.add_parser("probe-wired", help="read the wired device version using the vendor read handshake")
    commands.add_parser("wired-status", help="read wired DPI and polling rate without changing settings")
    commands.add_parser("get-lighting", help="read wireless LED color")
    light_parser = commands.add_parser("set-light-color", help="set wireless LED color (#RRGGBB)")
    light_parser.add_argument("value")
    power_parser = commands.add_parser("set-light-power", help="turn the wireless LED on or off")
    power_parser.add_argument("value", choices=("on", "off"))
    commands.add_parser("get-presets", help="read saved DPI presets")
    presets_parser = commands.add_parser("save-presets", help="save DPI presets")
    presets_parser.add_argument("values", help="JSON array of seven distinct supported DPI values")
    status = commands.add_parser("status", help="read current battery, DPI, and polling rate")
    add_debug_option(status)
    status.add_argument("--json", action="store_true", help="print one JSON object")
    watch_parser = commands.add_parser("watch", help="stream battery events without polling mouse settings")
    add_debug_option(watch_parser)
    dpi_parser = commands.add_parser("set-dpi", help="set the active DPI stage")
    add_debug_option(dpi_parser)
    dpi_parser.add_argument("value", type=int)
    polling_parser = commands.add_parser("set-polling", help="set polling rate in Hz")
    add_debug_option(polling_parser)
    polling_parser.add_argument("value", type=int, choices=sorted(mouse.POLLING_CODES))
    return parser


def status_once(device: str | None) -> dict:
    fd, path = mouse.open_device(device)
    try:
        if mouse.is_wired(path):
            result = mouse.wired_status(fd)
            with mouse.protocol_lock():
                mouse.drain_events(fd, result, timeout=0.2)
            return result
        cached = load_cached_status()
        battery = {key: cached[key] for key in ("battery", "chargeState") if cached.get(key) is not None}
        with mouse.protocol_lock():
            mouse.drain_events(fd, battery, timeout=0)
        result = mouse.query_status(fd, battery)
        with mouse.protocol_lock():
            mouse.drain_events(fd, battery, timeout=0)
        result.update(battery)
        save_cached_status(result)
        warnings = take_cache_warnings()
        if warnings:
            result["warnings"] = warnings
        return result
    finally:
        os.close(fd)


def cache_path() -> Path:
    state_home = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    return state_home / "omarchy" / "x11se-mouse" / "status.json"


@contextlib.contextmanager
def secure_directory(path: Path, private: bool):
    """Open each trusted path component without following symlinks."""
    if not path.is_absolute() or ".." in path.parts:
        raise OSError("Path must be absolute and contain no parent traversal")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    fd = os.open("/", flags)
    try:
        components = path.parent.parts[1:]
        for index, name in enumerate(components):
            is_private = private and index == len(components) - 1
            try:
                next_fd = os.open(name, flags, dir_fd=fd)
            except FileNotFoundError:
                try:
                    os.mkdir(name, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                next_fd = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = next_fd
            info = os.fstat(fd)
            owners = (os.geteuid(),) if is_private else (0, os.geteuid())
            forbidden = 0o077 if is_private else 0o022
            if info.st_uid not in owners or info.st_mode & forbidden:
                raise PermissionError(f"Unsafe directory ownership or permissions: {name}")
        yield fd, path.name
    finally:
        os.close(fd)


def cache_directory():
    return secure_directory(cache_path(), private=True)


def check_cache_file(fd: int, name: str) -> None:
    info = os.stat(name, dir_fd=fd, follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or info.st_nlink != 1:
        raise PermissionError("Unsafe cache file ownership, permissions, or type")


def cache_warning(operation: str, error: BaseException) -> None:
    mouse.CACHE_WARNINGS.append({"code": "cache_unavailable", "operation": operation, "error": str(error)})


def load_cached_status() -> dict:
    try:
        with cache_directory() as (directory, name):
            descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
            try:
                info = os.fstat(descriptor)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or info.st_nlink != 1:
                    raise PermissionError("Unsafe cache file ownership, permissions, or type")
                with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
                    descriptor = -1
                    data = json.loads(stream.read(65537))
                if isinstance(data, dict):
                    return data
                raise ValueError("Cache root is not a JSON object")
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
    except FileNotFoundError:
        pass
    except (OSError, ValueError, UnicodeError) as error:
        cache_warning("load_status_cache", error)
    return {"connected": True, "battery": None, "chargeState": None,
            "dpi": None, "stage": None, "stages": None, "polling": None, "error": None}


def save_cached_status(status: dict) -> None:
    try:
        with cache_directory() as (directory, name):
            try:
                check_cache_file(directory, name)
            except FileNotFoundError:
                pass
            temporary = ".x11se-mouse-" + secrets.token_hex(16)
            descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                                 0o600, dir_fd=directory)
            try:
                with os.fdopen(descriptor, "w", encoding="utf-8") as output:
                    json.dump(status, output, separators=(",", ":"))
                os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
            finally:
                try:
                    os.unlink(temporary, dir_fd=directory)
                except FileNotFoundError:
                    pass
    except (OSError, ValueError) as error:
        cache_warning("save_status_cache", error)


def presets_path() -> Path:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return config_home / "omarchy" / "x11se-presets.json"


def valid_presets(values) -> bool:
    choices = set(X11SE["verifiedDpi"] + X11SE["defaultPresets"])
    return (isinstance(values, list) and len(values) == 7
            and all(type(value) is int and value in choices for value in values)
            and len(set(values)) == 7)


def load_presets():
    try:
        with secure_directory(presets_path(), private=False) as (directory, name):
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
            try:
                info = os.fstat(fd)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or info.st_nlink != 1:
                    raise PermissionError("Unsafe presets file ownership, permissions, or type")
                with os.fdopen(fd, "r", encoding="utf-8") as stream:
                    fd = -1
                    values = json.loads(stream.read(4097))
            finally:
                if fd >= 0:
                    os.close(fd)
        if not valid_presets(values):
            raise ValueError("Invalid saved DPI presets")
        return values
    except FileNotFoundError:
        return None


def save_presets(values):
    if not valid_presets(values):
        raise ValueError("DPI presets must be seven distinct supported values")
    with secure_directory(presets_path(), private=False) as (directory, name):
        try:
            check_cache_file(directory, name)
        except FileNotFoundError:
            pass
        temporary = ".x11se-presets-" + secrets.token_hex(16)
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=directory)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as output:
                json.dump(values, output, separators=(",", ":"))
                output.write("\n")
            os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        finally:
            try:
                os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError:
                pass


def take_cache_warnings() -> list[dict[str, str]]:
    warnings = mouse.CACHE_WARNINGS[:]
    mouse.CACHE_WARNINGS.clear()
    return warnings


def watch(device: str | None, debug: bool = False) -> int:
    while True:
        path = device or mouse.find_hidraw()
        if not path:
            wired = mouse.hid_discovery.find_hidraw((X11SE_WIRED,), [])
            error = (mouse.MouseError("X11SE USB cable could not be opened", code="wired_open_failed")
                     if wired else mouse.MouseError("X11SE 2.4 GHz receiver was not found",
                                                    code="receiver_not_found",
                                                    details={"discovery_errors": mouse.DISCOVERY_ERRORS[:]}))
            status = mouse.device_error_status(error, "watch_discovery")
            mouse.json_line(status)
            time.sleep(3)
            continue
        try:
            fd, path = mouse.open_device(path)
        except mouse.MouseError as error:
            status = mouse.device_error_status(error, "watch_open")
            mouse.json_line(status)
            if debug:
                traceback.print_exception(type(error), error, error.__traceback__, file=sys.stderr)
            time.sleep(5)
            continue
        try:
            wired = mouse.is_wired(path)
            status = mouse.wired_status(fd) if wired else load_cached_status()
            status["transport"] = "wired" if wired else "receiver"
            status.update({"connected": True, "error": None})
            with mouse.protocol_lock():
                changed = mouse.drain_events(fd, status, timeout=0.2)
            if changed:
                status.pop("warnings", None)
                if not wired:
                    save_cached_status(status)
            warnings = take_cache_warnings()
            status.pop("warnings", None)
            if warnings:
                status["warnings"] = warnings
            mouse.json_line(status)
            while os.path.exists(path):
                if not device and mouse.find_hidraw() != path:
                    break
                with mouse.protocol_lock():
                    changed = mouse.drain_events(fd, status, timeout=0.2)
                if changed:
                    if wired:
                        mouse.json_line({"connected": True, "transport": "wired", "error": None,
                                         "battery": status.get("battery"),
                                         "chargeState": status.get("chargeState")})
                        continue
                    cached = load_cached_status()
                    cached.pop("warnings", None)
                    cached.update({
                        "connected": True,
                        "battery": status.get("battery"),
                        "chargeState": status.get("chargeState"),
                        "error": None,
                    })
                    status.update(cached)
                    save_cached_status(cached)
                    warnings = take_cache_warnings()
                    status.pop("warnings", None)
                    if warnings:
                        status["warnings"] = warnings
                    mouse.json_line(status)
        except Exception as error:
            mouse.json_line(mouse.device_error_status(error, "watch_events"))
            if debug:
                traceback.print_exception(type(error), error, error.__traceback__, file=sys.stderr)
        finally:
            os.close(fd)
        time.sleep(1)


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "capabilities":
            print(json.dumps(X11SE, separators=(",", ":")))
            return 0
        if args.command == "devices":
            devices = []
            errors = []
            for model, transport, supported in ((X11SE, "receiver", True), (X11SE_WIRED, "wired", True)):
                discovery_errors = []
                match = mouse.hid_discovery.find_hidraw((model,), discovery_errors)
                errors.extend(discovery_errors)
                if match:
                    devices.append({"transport": transport, "device": match[1], "supported": supported})
            print(json.dumps({"devices": devices, "discovery_errors": errors}, separators=(",", ":")))
            return 0
        if args.command in ("probe-wired", "wired-status"):
            match = mouse.hid_discovery.find_hidraw((X11SE_WIRED,), [])
            if not match:
                raise mouse.MouseError("X11SE wired interface was not found", code="wired_not_found")
            try:
                fd = os.open(match[1], os.O_RDWR | os.O_NONBLOCK)
            except OSError as error:
                raise mouse.MouseError(f"Could not open wired interface {match[1]}: {error.strerror}",
                                       code="wired_open_failed") from error
            try:
                if args.command == "probe-wired":
                    with mouse.protocol_lock():
                        report = mouse.read_wired_feature(fd, 0x0b, 8, profile=0)
                    result = {"device": match[1], "report": report.hex()}
                else:
                    result = mouse.wired_status(fd)
                print(json.dumps(result, separators=(",", ":")))
                return 0
            finally:
                os.close(fd)
        if args.command == "get-presets":
            print(json.dumps({"ok": True, "presets": load_presets()}))
            return 0
        if args.command == "save-presets":
            save_presets(json.loads(args.values))
            print(json.dumps({"ok": True}))
            return 0
        if args.command == "watch":
            return watch(args.device, args.debug)
        if args.command == "status":
            result = status_once(args.device)
            if args.json:
                print(json.dumps(result, separators=(",", ":")))
            else:
                print(mouse.status_text(result))
            return 0 if result["connected"] else 1
        if args.command in ("set-dpi", "set-polling", "set-light-color", "set-light-power") and not mouse.WRITES_ENABLED:
            raise mouse.MouseError("X11SE setting writes are disabled because they disconnect the receiver")
        fd, path = mouse.open_device(args.device)
        try:
            if args.command in ("get-lighting", "set-light-color", "set-light-power"):
                if mouse.is_wired(path):
                    raise mouse.MouseError("LED control is not yet verified for USB", code="lighting_unsupported_transport")
                if args.command == "get-lighting":
                    with mouse.protocol_lock():
                        report = mouse.read_lighting(fd)
                    result = {"color": mouse.lighting_color(report), "power": mouse.lighting_power(report)}
                elif args.command == "set-light-color":
                    result = mouse.set_lighting_color(fd, args.value)
                else:
                    result = mouse.set_lighting_power(fd, args.value)
                print(json.dumps({"ok": True, **result}, separators=(",", ":")))
                return 0
            if mouse.is_wired(path):
                result = mouse.set_wired(fd, args.command, args.value)
                result.update({"ok": True, "message": f"{args.command[4:].capitalize()} set to {args.value}"})
                print(json.dumps(result, separators=(",", ":")))
                return 0
            if args.command == "set-dpi":
                changed = mouse.set_dpi(fd, args.value)
                result = {"ok": True, **changed,
                          "message": f"Active DPI set to {changed['dpi']}"}
                if not changed["acknowledged"]:
                    result.setdefault("warnings", []).append({
                        "code": "ack_timeout", "operation": "set_dpi", "report_id": "0x04",
                        "resolution": "requested DPI was confirmed by feature-report readback",
                    })
                cached = load_cached_status()
                cached.update({key: changed.get(key) for key in ("dpi", "stage", "stages")})
                cached["connected"] = True
                save_cached_status(cached)
                result.setdefault("warnings", []).extend(take_cache_warnings())
            elif args.command == "set-polling":
                rate, acknowledged = mouse.set_polling(fd, args.value)
                result = {"ok": True, "polling": rate, "verified": True, "acknowledged": acknowledged,
                          "message": f"Polling rate set to {rate} Hz"}
                if not acknowledged:
                    result["warnings"] = [{
                        "code": "ack_timeout", "operation": "set_polling", "report_id": "0x06",
                        "resolution": "requested polling rate was confirmed by feature-report readback",
                    }]
                cached = load_cached_status()
                cached.update({"connected": True, "polling": rate})
                save_cached_status(cached)
                result.setdefault("warnings", []).extend(take_cache_warnings())
            else:
                raise ValueError(f"Unknown command: {args.command}")
            print(json.dumps(result, separators=(",", ":")))
            return 0
        finally:
            os.close(fd)
    except Exception as error:
        result = {"ok": False, **mouse.device_error_status(error, args.command)}
        if args.debug:
            traceback.print_exception(type(error), error, error.__traceback__, file=sys.stderr)
        if args.command == "status":
            if not args.json:
                print(mouse.status_text(result))
            else:
                print(json.dumps(result, separators=(",", ":")))
        elif args.command == "watch":
            mouse.json_line(result)
        else:
            print(json.dumps(result, separators=(",", ":")))
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
